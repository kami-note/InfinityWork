generator client {
  provider = "prisma-client-js"
  // See services/auth/prisma/schema.prisma for why this isn't the default
  // hoisted node_modules/@prisma/client path.
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_FILE_MANAGER")
}

enum FilePermissionRole {
  owner
  editor
  viewer
}

enum ShareLinkTargetType {
  file
  folder
}

model Folder {
  id          String             @id @default(uuid())
  name        String
  parentId    String?            @map("parent_id")
  parent      Folder?            @relation("FolderTree", fields: [parentId], references: [id])
  children    Folder[]           @relation("FolderTree")
  ownerId     String             @map("owner_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  files       File[]
  permissions FolderPermission[]

  @@index([parentId])
  @@index([ownerId])
  @@map("folders")
}

model File {
  id             String           @id @default(uuid())
  name           String
  folderId       String?          @map("folder_id")
  folder         Folder?          @relation(fields: [folderId], references: [id])
  ownerId        String           @map("owner_id")
  storageKey     String           @map("storage_key")
  size           BigInt
  mimeType       String           @map("mime_type")
  checksumSha256 String           @map("checksum_sha256")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  thumbnailStatus String          @default("none") @map("thumbnail_status")
  thumbnailStorageKey String?     @map("thumbnail_storage_key")
  permissions    FilePermission[]

  @@index([folderId])
  @@index([ownerId])
  @@map("files")
}

model FilePermission {
  fileId String             @map("file_id")
  userId String             @map("user_id")
  role   FilePermissionRole
  file   File               @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([fileId, userId])
  @@index([userId])
  @@map("file_permissions")
}

model FolderPermission {
  folderId String             @map("folder_id")
  userId   String             @map("user_id")
  role     FilePermissionRole
  folder   Folder             @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@id([folderId, userId])
  @@index([userId])
  @@map("folder_permissions")
}

model ShareLink {
  id        String              @id @default(uuid())
  tokenHash String              @unique @map("token_hash")
  targetType ShareLinkTargetType @map("target_type")
  targetId  String              @map("target_id")
  role      FilePermissionRole  @default(viewer)
  expiresAt DateTime?           @map("expires_at")
  revokedAt DateTime?           @map("revoked_at")
  createdBy String              @map("created_by")
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@map("share_links")
}
