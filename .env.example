# Postgres (single instance, schemas: auth, file_manager)
POSTGRES_USER=infinitywork
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infinitywork
DATABASE_URL_AUTH=postgresql://infinitywork:change-me@postgres:5432/infinitywork?schema=auth
DATABASE_URL_FILE_MANAGER=postgresql://infinitywork:change-me@postgres:5432/infinitywork?schema=file_manager

# JWT (shared secret between auth and every module that validates tokens)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# File storage (local filesystem volume mounted into file-manager service)
STORAGE_ROOT=/data/storage
# Max final file size after chunked (or single) upload. During assemble the
# VPS needs free space >= this file's size (parts + final until parts are deleted).
STORAGE_MAX_UPLOAD_BYTES=5368709120
# Chunked uploads (bypass ~100MB Cloudflare proxy limit). Client uses the same
# defaults from @infinitywork/shared unless NEXT_PUBLIC_* overrides in the portal.
CHUNK_UPLOAD_SIZE_BYTES=83886080
CHUNK_UPLOAD_THRESHOLD_BYTES=94371840
CHUNK_UPLOAD_MAX_REQUEST_BYTES=94371840

# Internal service URLs (only reachable inside the Docker network)
AUTH_SERVICE_URL=http://auth:4001
FILE_MANAGER_SERVICE_URL=http://file-manager:4002
DOCS_SERVICE_URL=http://docs:4003

# Portal (only service exposed publicly)
PORTAL_PORT=3000
